+// Metadata only: no binary64 conversion. Both embedded A rows contain the same real/imaginary components.
+inline int dense_spread(const Vec& A, size_t m, size_t k, const Vec& B, size_t n) {
+  long largest = 0;
+  auto line = [&](const Vec& values, size_t offset, size_t stride, size_t count) {
+    long lo = LONG_MAX, hi = LONG_MIN;
+    for (size_t q = 0; q < count; ++q) { const C& z = values[offset + q * stride];
+      for (auto v : {mpc_realref(z.v), mpc_imagref(z.v)}) {
+        if (!mpfr_number_p(v)) throw std::runtime_error("GEMM: nonfinite input");
+        if (!mpfr_zero_p(v)) { long e = mpfr_get_exp(v); lo = std::min(lo, e); hi = std::max(hi, e); }
+      }
+    }
+    if (hi != LONG_MIN) largest = std::max(largest, hi - lo);
+  };
+  for (size_t i = 0; i < m; ++i) line(A, i * k, 1, k);
+  for (size_t j = 0; j < n; ++j) line(B, j, n, k);
+  if (largest > 8190) throw std::runtime_error("GPU GEMM: exponent spread exceeds 8192-bit workspace limit");
+  return int((largest + 2 + 63) / 64 * 64); // two bits cover a possible import rounding carry
+}
+inline limbforge::Linalg& dense_la(int spread, int threads) {
+  static thread_local std::map<std::pair<int,int>, std::unique_ptr<limbforge::Linalg>> cache;
+  auto key = std::make_pair(spread, std::max(1, threads)); auto& item = cache[key];
+  if (!item) { limbforge::LinalgOptions options; options.band_bits = 512;
+    options.max_spread = spread; options.max_bands = 1 + spread / 513; options.host_threads = key.second;
+    item = std::make_unique<limbforge::Linalg>(engine(), options);
+  }
+  return *item;
+}
